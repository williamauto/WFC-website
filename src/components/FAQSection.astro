---
const { title, items } = Astro.props;
---

<section class="mt-12" aria-label="Frequently asked questions">
  <h2 class="text-2xl font-bold text-ocean-900 mb-6">{title || 'Frequently Asked Questions'}</h2>
  <div class="space-y-4">
    {items.map((item, i) => (
      <details class="group bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
        <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-medium text-gray-900 hover:bg-ocean-50 transition-colors">
          <span>{item.question}</span>
          <svg class="w-5 h-5 text-ocean-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="px-5 pb-4 text-gray-700 leading-relaxed">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>