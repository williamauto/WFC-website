---
import { getActivity, getRegion } from '../data/site-data';

const { activitySlug, regionSlug, subSlug, href } = Astro.props;
const activity = getActivity(activitySlug);
if (!activity) return null;

let link = href;
if (!link) {
  const region = regionSlug ? getRegion(regionSlug) : null;
  if (region) {
    link = `/${region.stateSlug}/${regionSlug}/${subSlug ? subSlug + '/' : ''}${activitySlug}/`;
  } else {
    link = `/activities/${activitySlug}/`;
  }
}
---

<a href={link} class="group block bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-ocean-300 transition-all overflow-hidden">
  <div class="p-6">
    <div class="text-4xl mb-3">{activity.icon}</div>
    <h3 class="font-bold text-lg text-ocean-900 group-hover:text-ocean-600 transition-colors">{activity.name}</h3>
    <p class="text-sm text-gray-600 mt-2 leading-relaxed">{activity.description}</p>
    <span class="inline-flex items-center mt-4 text-sm font-medium text-ocean-600 group-hover:text-ocean-800">
      Explore {activity.shortName}
      <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>