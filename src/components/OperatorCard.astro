---
const { name, rating, reviewCount, price, url, description } = Astro.props;
---

<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between">
    <div>
      <h3 class="font-bold text-ocean-900">{name}</h3>
      {rating && (
        <div class="flex items-center mt-1">
          <span class="text-amber-400">★</span>
          <span class="text-sm font-medium ml-1">{rating}</span>
          {reviewCount && <span class="text-sm text-gray-500 ml-1">({reviewCount} reviews)</span>}
        </div>
      )}
    </div>
    {price && <span class="text-sm font-semibold text-ocean-600 bg-ocean-50 px-3 py-1 rounded-full">{price}</span>}
  </div>
  {description && <p class="text-sm text-gray-600 mt-3 leading-relaxed">{description}</p>}
  {url && (
    <a href={url} target="_blank" rel="noopener sponsored" class="inline-flex items-center mt-4 px-4 py-2 bg-ocean-600 text-white text-sm font-medium rounded-lg hover:bg-ocean-700 transition-colors">
      Book Now
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>
  )}
</div>