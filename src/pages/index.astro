---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site-data';
import { buildWebSiteSchema, buildBreadcrumbSchema } from '../data/schema';

const schema = [
  buildWebSiteSchema(),
  buildBreadcrumbSchema([{ label: 'Home', url: '/' }])
];

// Featured experiences — curated picks linking to real guides
const featured = [
  {
    name: 'Emerald Reef Snorkel Tour',
    area: 'Key Biscayne',
    price: '$65 / person',
    rating: '4.9',
    tag: 'Snorkeling',
    icon: '🐠',
    desc: 'Shallow reef swim over Emerald Reef\'s coral heads, minutes from the marina.',
    url: '/florida/miami/key-biscayne/snorkeling/'
  },
  {
    name: 'Biscayne Bay Sunset Sail',
    area: 'Coconut Grove',
    price: '$89 / person',
    rating: '4.8',
    tag: 'Sailing',
    icon: '⛵',
    desc: 'A quiet sail across the bay as the Miami skyline turns gold.',
    url: '/florida/miami/bayside/'
  },
  {
    name: 'Haulover Inlet Jet Ski Run',
    area: 'Haulover',
    price: '$120 / hour',
    rating: '4.7',
    tag: 'Jet Ski',
    icon: '🚤',
    desc: 'Open-water runs past the inlet with a guide who knows the sandbars.',
    url: '/florida/miami/haulover/jet-ski-rental/'
  },
  {
    name: 'Oleta Mangrove Paddle',
    area: 'Oleta River State Park',
    price: '$45 / person',
    rating: '4.9',
    tag: 'Paddleboarding',
    icon: '🛶',
    desc: 'Glide through Florida\'s largest urban mangrove tunnel system.',
    url: '/florida/miami/oleta-river/kayaking/'
  },
  {
    name: 'Stiltsville Boat & Snorkel',
    area: 'Biscayne Bay',
    price: '$150 / person',
    rating: '5.0',
    tag: 'Boat Tours',
    icon: '🏝️',
    desc: 'Cruise past the historic stilt houses, then anchor for an open-water snorkel.',
    url: '/florida/miami/biscayne-national-park/snorkeling/'
  },
  {
    name: 'Alligator Reef Dive Charter',
    area: 'Islamorada',
    price: '$135 / person',
    rating: '4.8',
    tag: 'Diving',
    icon: '🪸',
    desc: 'Two-tank reef dive on one of the Keys\' best-preserved living reefs.',
    url: '/florida/florida-keys/islamorada/snorkeling/'
  },
  {
    name: 'South Beach Deep Sea Fishing',
    area: 'South Beach Marina',
    price: '$220 / boat',
    rating: '4.6',
    tag: 'Fishing Charters',
    icon: '🎣',
    desc: 'Half-day offshore run for mahi, sailfish, and whatever\'s biting.',
    url: '/florida/miami/south-beach/'
  },
  {
    name: 'Virginia Key Kayak & Snorkel',
    area: 'Virginia Key',
    price: '$55 / person',
    rating: '4.9',
    tag: 'Snorkeling',
    icon: '🌊',
    desc: 'Paddle out to a calm reef flat, then snorkel right off the kayak.',
    url: '/florida/miami/virginia-key/kayaking/'
  }
];

const stats = [
  { value: '180+', label: 'Verified experiences' },
  { value: '60', label: 'Local operators' },
  { value: '4.9', label: 'Average guest rating' },
  { value: '12', label: 'Miami waterways covered' }
];

const steps = [
  {
    num: '01',
    title: 'Browse verified spots',
    desc: 'Filter Miami\'s coastline by activity, location, and price — every listing is confirmed with the operator directly.'
  },
  {
    num: '02',
    title: 'Compare and book',
    desc: 'See real availability, transparent pricing, and reviews from guests who actually went out on the water.'
  },
  {
    num: '03',
    title: 'Show up and dive in',
    desc: 'Your captain or guide meets you dockside with your booking already confirmed. No paperwork, no surprises.'
  }
];

// Filter tabs — link to real pages where they exist
const filters = [
  { label: 'All spots', url: '/activities/' },
  { label: 'Snorkeling', url: '/activities/snorkeling/' },
  { label: 'Boat tours', url: '/florida/miami/bayside/' },
  { label: 'Diving', url: '/activities/snorkeling/' },
  { label: 'Paddleboarding', url: '/activities/paddleboarding/' },
  { label: 'Sailing', url: '/florida/miami/bayside/' },
  { label: 'Jet ski', url: '/activities/jet-ski-rental/' },
  { label: 'Fishing charters', url: '/florida/miami/south-beach/' }
];
---

<Layout title="Water Activities & Tours Guide" description={SITE.description} schema={schema}>
  <!-- Hero -->
  <section class="bg-mist">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <p class="text-ocean-700 font-semibold tracking-widest uppercase text-sm mb-4">Explore — spots and experiences, picked for the water you're in the mood for</p>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-ocean-950 leading-tight">MIAMI, ON THE WATER</h1>
      <p class="mt-4 text-2xl md:text-3xl font-bold text-ocean-800">Find your calm below the surface.</p>
      <p class="mt-6 text-lg text-gray-600 max-w-2xl leading-relaxed">
        Water Fun Club is Miami's marketplace for marine experiences — snorkeling, boat tours, diving, and paddling,
        booked straight from the people who run them, from Haulover to Islamorada.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/activities/" class="px-6 py-3 bg-ocean-800 text-white font-semibold rounded-lg hover:bg-ocean-700 transition-colors">Explore experiences</a>
        <a href="/florida/miami/" class="px-6 py-3 bg-white text-ocean-800 font-semibold rounded-lg border-2 border-ocean-800 hover:bg-ocean-50 transition-colors">List your business</a>
      </div>

      <!-- Search bar -->
      <div class="mt-8 max-w-2xl">
        <form action="/activities/" class="flex flex-col sm:flex-row gap-2 bg-white rounded-xl p-2 shadow-md border border-ocean-100">
          <input
            type="text"
            placeholder="Snorkeling, boat tour, jet ski… Anywhere in Miami"
            class="flex-1 px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none rounded-lg"
            aria-label="Search activities"
          />
          <button type="submit" class="px-6 py-3 bg-sand-400 text-ocean-950 font-semibold rounded-lg hover:bg-sand-300 transition-colors">
            Search
          </button>
        </form>
      </div>

      <!-- Stats -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-3xl">
        {stats.map(s => (
          <div>
            <div class="text-3xl font-extrabold text-ocean-800">{s.value}</div>
            <div class="text-sm text-gray-500 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Filter tabs + Featured experiences -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-2 mb-10">
        {filters.map((f, i) => (
          <a href={f.url} class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${i === 0 ? 'bg-ocean-800 text-white' : 'bg-mist border border-ocean-200 text-ocean-800 hover:bg-ocean-50'}`}>{f.label}</a>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featured.map(f => (
          <a href={f.url} class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all overflow-hidden border border-ocean-100 flex flex-col">
            <div class="h-32 bg-gradient-to-br from-ocean-100 to-ocean-200 flex items-center justify-center">
              <span class="text-5xl">{f.icon}</span>
            </div>
            <div class="p-5 flex flex-col flex-grow">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-ocean-700 bg-ocean-50 px-2 py-1 rounded-full">{f.tag}</span>
                <span class="text-sm font-bold text-sand-600">★ {f.rating}</span>
              </div>
              <h3 class="font-bold text-ocean-900 group-hover:text-ocean-600 transition-colors">{f.name}</h3>
              <p class="text-xs text-gray-500 mt-1">{f.area}</p>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed flex-grow">{f.desc}</p>
              <div class="flex items-center justify-between mt-4">
                <span class="text-sm font-bold text-ocean-800">{f.price}</span>
                <span class="text-sm font-medium text-ocean-600 group-hover:translate-x-1 transition-transform">View guide →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-mist py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-ocean-950 text-center mb-2">How it works</h2>
      <p class="text-center text-gray-600 mb-12">Three steps between you and the water.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {steps.map(s => (
          <div class="text-center">
            <div class="text-5xl font-extrabold text-ocean-200 mb-4">{s.num}</div>
            <h3 class="text-xl font-bold text-ocean-900 mb-3">{s.title}</h3>
            <p class="text-gray-600 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- More destinations -->
  <section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-ocean-950">Beyond Miami</h2>
        <p class="mt-3 text-gray-600 max-w-2xl mx-auto">The same spot-level guides, for more of the world's best water.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href="/florida/florida-keys/" class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all overflow-hidden border border-ocean-100">
          <div class="h-40 bg-gradient-to-br from-ocean-300 to-ocean-600 flex items-center justify-center">
            <span class="text-5xl">🪸</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-ocean-900 group-hover:text-ocean-600">Florida Keys</h3>
            <p class="text-sm text-gray-600 mt-2">Key Largo, Key West, and Islamorada — the only living coral barrier reef in the continental US.</p>
            <span class="inline-flex items-center mt-4 text-sm font-medium text-ocean-600">Explore the Keys →</span>
          </div>
        </a>
        <a href="/hawaii/oahu/" class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all overflow-hidden border border-ocean-100">
          <div class="h-40 bg-gradient-to-br from-ocean-500 to-ocean-900 flex items-center justify-center">
            <span class="text-5xl">🌺</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-ocean-900 group-hover:text-ocean-600">Oahu, Hawaii</h3>
            <p class="text-sm text-gray-600 mt-2">Sharks Cove, Hanauma Bay, Waikiki sunset cruises, and world-class surfing on the North Shore.</p>
            <span class="inline-flex items-center mt-4 text-sm font-medium text-ocean-600">Explore Oahu →</span>
          </div>
        </a>
        <a href="/puerto-rico/" class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all overflow-hidden border border-ocean-100">
          <div class="h-40 bg-gradient-to-br from-sand-400 to-sand-700 flex items-center justify-center">
            <span class="text-5xl">🏝️</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-ocean-900 group-hover:text-ocean-600">Puerto Rico</h3>
            <p class="text-sm text-gray-600 mt-2">Bioluminescent bay kayaking in Vieques, Flamenco Beach snorkeling, and Caribbean water adventures.</p>
            <span class="inline-flex items-center mt-4 text-sm font-medium text-ocean-600">Explore Puerto Rico →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="bg-ocean-900 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="text-5xl mb-6">💬</div>
      <blockquote class="text-2xl md:text-3xl font-semibold leading-relaxed">
        "We booked a sunset sail out of Coconut Grove an hour before it left the dock. Easiest booking of the whole trip."
      </blockquote>
      <p class="mt-6 text-ocean-200 font-medium">— A Water Fun Club guest, Biscayne Bay</p>
    </div>
  </section>
</Layout>