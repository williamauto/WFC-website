---
import Layout from '../../../../layouts/Layout.astro';
import Hero from '../../../../components/Hero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ActivityCard from '../../../../components/ActivityCard.astro';
import OperatorCard from '../../../../components/OperatorCard.astro';
import FAQSection from '../../../../components/FAQSection.astro';
import { getRegion, getActivitiesForRegion } from '../../../../data/site-data';
import { buildTouristDestinationSchema, buildBreadcrumbSchema, buildFAQSchema } from '../../../../data/schema';

const region = getRegion('miami');
const activities = getActivitiesForRegion('miami');

const faqs = [
  {
    question: 'Where is Oleta River State Park?',
    answer: 'Oleta River State Park is at 3400 NE 163rd St, North Miami Beach, FL 33160 — about 20 minutes north of downtown Miami. It\'s Florida\'s largest urban park with 1,043 acres of mangrove forest and waterways.'
  },
  {
    question: 'What is the best kayaking in Oleta River?',
    answer: 'The mangrove trails of Oleta River are the best kayaking in Miami. Paddle through narrow mangrove tunnels where you\'ll see birds, rays, and occasionally manatees. Kayak rentals cost $25–$35 per hour at the park concession.'
  },
  {
    question: 'How much does it cost to enter Oleta River State Park?',
    answer: 'Entry is $6 per vehicle (up to 8 people). Kayak rentals are $25–$35/hour. The park is open 8 AM to sunset year-round. It\'s one of the best-value water activity experiences in Miami.'
  }
];

const schema = [
  buildTouristDestinationSchema({
    name: 'Oleta River',
    description: 'Oleta River — Florida\'s urban wilderness with mangrove kayaking trails.',
    url: '/florida/miami/oleta-river/',
    activities
  }),
  buildBreadcrumbSchema([
    { label: 'Home', url: '/' },
    { label: 'Florida', url: '/florida/' },
    { label: 'Miami', url: '/florida/miami/' },
    { label: 'Oleta River', url: '/florida/miami/oleta-river/' }
  ]),
  buildFAQSchema(faqs)
];
---

<Layout title="Oleta River Kayaking — Miami's Mangrove Trails" description="Oleta River State Park kayaking guide — paddle through mangrove tunnels in Florida's largest urban park." schema={schema}>
  <Breadcrumbs items={[
    { label: 'Home', url: '/' },
    { label: 'Florida', url: '/florida/' },
    { label: 'Miami', url: '/florida/miami/' },
    { label: 'Oleta River' }
  ]} />

  <Hero
    title="Oleta River Kayaking"
    subtitle="Florida's urban wilderness — paddle through mangrove tunnels just 20 minutes from downtown Miami."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-ocean-900 mb-6">Water Activities at Oleta River</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {activities.map(activity => (
        <ActivityCard activitySlug={activity.slug} regionSlug="miami" />
      ))}
    </div>
  </section>

  <section class="bg-ocean-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ocean-900 mb-6">Why Oleta River?</h2>
      <div class="prose-custom">
        <p>Oleta River State Park is Florida's largest urban park — 1,043 acres of mangrove forest, waterways, and wildlife. It's the best kayaking in Miami:</p>
        <ul>
          <li><strong>Mangrove tunnels</strong> — paddle through narrow channels lined with red mangroves</li>
          <li><strong>Wildlife</strong> — birds, rays, manatees, and occasional dolphins</li>
          <li><strong>Beginner-friendly</strong> — calm, protected waters with no ocean swells</li>
          <li><strong>Affordable</strong> — $6 entry, $25–$35/hour kayak rental</li>
          <li><strong>Close to everything</strong> — 20 minutes from downtown Miami</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <FAQSection items={faqs} />
  </section>
</Layout>