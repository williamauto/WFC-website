---
import Layout from '../../../../layouts/Layout.astro';
import Hero from '../../../../components/Hero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ActivityCard from '../../../../components/ActivityCard.astro';
import OperatorCard from '../../../../components/OperatorCard.astro';
import FAQSection from '../../../../components/FAQSection.astro';
import { getRegion, getActivitiesForRegion } from '../../../../data/site-data';
import { buildTouristDestinationSchema, buildBreadcrumbSchema, buildFAQSchema } from '../../../../data/schema';

const region = getRegion('miami');
const activities = getActivitiesForRegion('miami');

const faqs = [
  {
    question: 'Where is the best snorkeling in Key Biscayne?',
    answer: 'Crandon Park and Bill Baggs Cape Florida State Park offer the best shore snorkeling in Key Biscayne. The seagrass beds attract manatees and sea turtles, and the calm, shallow water is perfect for beginners. For reef snorkeling, take a short boat trip to Biscayne National Park.'
  },
  {
    question: 'Can you kayak in Key Biscayne?',
    answer: 'Yes, Key Biscayne is one of the best kayaking spots in Miami. Crandon Park has calm lagoon waters perfect for beginners, and you can paddle through mangrove channels to see birds, rays, and manatees. Kayak rentals cost $25–$40 per hour.'
  },
  {
    question: 'Is Key Biscayne good for families?',
    answer: 'Absolutely. Key Biscayne has calm, shallow water, lifeguarded beaches, and gentle kayaking conditions. Crandon Park has picnic areas, playgrounds, and a nature center. It\'s the most family-friendly water activity area in Miami.'
  }
];

const schema = [
  buildTouristDestinationSchema({
    name: 'Key Biscayne',
    description: 'Key Biscayne, tropical island escape with calm snorkeling and kayaking waters.',
    url: '/florida/miami/key-biscayne/',
    activities
  }),
  buildBreadcrumbSchema([
    { label: 'Home', url: '/' },
    { label: 'Florida', url: '/florida/' },
    { label: 'Miami', url: '/florida/miami/' },
    { label: 'Key Biscayne', url: '/florida/miami/key-biscayne/' }
  ]),
  buildFAQSchema(faqs)
];
---

<Layout title="Key Biscayne Water Activities, Snorkeling & Kayaking" description="Key Biscayne water activities: snorkeling, kayaking, and paddle boarding in calm tropical waters. Family-friendly guide." schema={schema}>
  <Breadcrumbs items={[
    { label: 'Home', url: '/' },
    { label: 'Florida', url: '/florida/' },
    { label: 'Miami', url: '/florida/miami/' },
    { label: 'Key Biscayne' }
  ]} />

  <Hero
    title="Key Biscayne Water Activities"
    subtitle="A tropical island escape 15 minutes from downtown Miami, calm waters, manatees, and family-friendly adventures."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-ocean-900 mb-6">Water Activities in Key Biscayne</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {activities.map(activity => (
        <ActivityCard activitySlug={activity.slug} regionSlug="miami" />
      ))}
    </div>
  </section>

  <section class="bg-ocean-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ocean-900 mb-6">Top Key Biscayne Experiences</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-dashed border-ocean-200 bg-white p-6 text-center col-span-full">
            <p class="text-sm text-gray-600">Verified tours and operators for this spot are being added. Check back soon, or <a href="/list-your-business/" class="text-ocean-600 underline">list your business</a> if you run one here.</p>
          </div>
      </div>
      <p class="text-xs text-gray-500 mt-4">* Water Fun Club may earn a commission from bookings made through these links.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <FAQSection items={faqs} />
  </section>
</Layout>