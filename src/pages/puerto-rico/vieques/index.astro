---
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/Hero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ActivityCard from '../../../components/ActivityCard.astro';
import { getRegion, getActivitiesForRegion } from '../../../data/site-data';
import { buildTouristDestinationSchema, buildBreadcrumbSchema } from '../../../data/schema';

const region = getRegion('vieques');
const activities = getActivitiesForRegion('vieques');

const schema = [
  buildTouristDestinationSchema({
    name: 'Vieques',
    description: region.description,
    url: '/puerto-rico/vieques/',
    activities
  }),
  buildBreadcrumbSchema([
    { label: 'Home', url: '/' },
    { label: 'Puerto Rico', url: '/puerto-rico/' },
    { label: 'Vieques', url: '/puerto-rico/vieques/' }
  ])
];
---

<Layout title="Vieques Water Activities" description={region.description} schema={schema}>
  <Breadcrumbs items={[
    { label: 'Home', url: '/' },
    { label: 'Puerto Rico', url: '/puerto-rico/' },
    { label: 'Vieques' }
  ]} />

  <Hero
    title="Vieques Water Activities"
    subtitle="Home to Mosquito Bay — the brightest bioluminescent bay in the world. Night kayaking you'll never forget."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-ocean-900 mb-6">Water Activities in Vieques</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {activities.map(activity => (
        <ActivityCard activitySlug={activity.slug} regionSlug="vieques" />
      ))}
    </div>
  </section>

  <section class="bg-ocean-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ocean-900 mb-6">Explore Vieques</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {region.subDestinations.map(sub => (
          <a href={`/puerto-rico/vieques/${sub.slug}/`} class="group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all p-6">
            <h3 class="font-bold text-ocean-900 group-hover:text-ocean-600">{sub.name}</h3>
            <p class="text-sm text-gray-600 mt-2">{sub.description}</p>
            <span class="inline-flex items-center mt-3 text-sm font-medium text-ocean-600">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>