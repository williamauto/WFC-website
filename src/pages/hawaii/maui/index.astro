---
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/Hero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getRegion, getActivitiesForRegion } from '../../../data/site-data';
import { buildTouristDestinationSchema, buildBreadcrumbSchema } from '../../../data/schema';

const region = getRegion('maui');
const activities = getActivitiesForRegion('maui');

const schema = [
  buildTouristDestinationSchema({
    name: 'Maui',
    description: region.description,
    url: '/hawaii/maui/',
    activities
  }),
  buildBreadcrumbSchema([
    { label: 'Home', url: '/' },
    { label: 'Hawaii', url: '/hawaii/' },
    { label: 'Maui', url: '/hawaii/maui/' }
  ])
];
---

<Layout title="Maui Water Activities" description={region.description} schema={schema}>
  <Breadcrumbs items={[
    { label: 'Home', url: '/' },
    { label: 'Hawaii', url: '/hawaii/' },
    { label: 'Maui' }
  ]} />

  <Hero
    title="Maui Water Activities"
    subtitle="Molokini Crater, Kaanapali Beach, and the Valley Isle's legendary snorkeling waters."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-ocean-900 mb-6">Explore Maui</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {region.subDestinations.map(sub => (
        <a href={`/hawaii/maui/${sub.slug}/`} class="group bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all p-6">
          <h3 class="font-bold text-ocean-900 group-hover:text-ocean-600">{sub.name}</h3>
          <p class="text-sm text-gray-600 mt-2">{sub.description}</p>
          <span class="inline-flex items-center mt-3 text-sm font-medium text-ocean-600">Explore →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-ocean-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ocean-900 mb-6">Why Maui?</h2>
      <div class="prose-custom">
        <p>Maui is Hawaii's snorkeling capital. The island's leeward coast offers calm, protected waters with world-class reef access:</p>
        <ul>
          <li><strong>Molokini Crater</strong> — a volcanic atoll with 250+ fish species and visibility up to 150 feet</li>
          <li><strong>Kaanapali Beach</strong> — resort coast with gentle waters perfect for beginners</li>
          <li><strong>Lahaina</strong> — historic whaling town with boat tours and sunset cruises</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>