---
import Layout from '../../../../layouts/Layout.astro';
import Hero from '../../../../components/Hero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ActivityCard from '../../../../components/ActivityCard.astro';
import FAQSection from '../../../../components/FAQSection.astro';
import { getRegion, getActivitiesForRegion } from '../../../../data/site-data';
import { buildTouristDestinationSchema, buildBreadcrumbSchema, buildFAQSchema } from '../../../../data/schema';

const region = getRegion('oahu');
const activities = getActivitiesForRegion('oahu');

const faqs = [
  {
    question: 'Where is Kuilima Cove?',
    answer: 'Kuilima Cove is on Oahu\'s North Shore, at the Turtle Bay Resort (57-091 Kamehameha Hwy, Kahuku, HI 96731). It\'s a protected cove with calm, shallow water, one of the best beginner snorkeling spots on the island.'
  },
  {
    question: 'Is Kuilima Cove free?',
    answer: 'Yes, Kuilima Cove is free to access. You can park at the Turtle Bay Resort public lot (free) and walk to the cove. Snorkel gear can be rented from the resort or nearby shops.'
  },
  {
    question: 'What will I see snorkeling at Kuilima Cove?',
    answer: 'Kuilima Cove has a healthy reef with tropical fish, sea turtles, and occasional rays. The water is calm and shallow (3–8 feet), making it perfect for beginners and families.'
  }
];

const schema = [
  buildTouristDestinationSchema({
    name: 'Kuilima Cove',
    description: 'Kuilima Cove, North Shore cove with beginner-friendly snorkeling at Turtle Bay Resort.',
    url: '/hawaii/oahu/kuilima-cove/',
    activities
  }),
  buildBreadcrumbSchema([
    { label: 'Home', url: '/' },
    { label: 'Hawaii', url: '/hawaii/' },
    { label: 'Oahu', url: '/hawaii/oahu/' },
    { label: 'Kuilima Cove', url: '/hawaii/oahu/kuilima-cove/' }
  ]),
  buildFAQSchema(faqs)
];
---

<Layout title="Kuilima Cove Snorkeling, Beginner's Guide" description="Kuilima Cove snorkeling guide, calm, shallow waters at Turtle Bay Resort. Free entry, sea turtles, and tropical fish." schema={schema}>
  <Breadcrumbs items={[
    { label: 'Home', url: '/' },
    { label: 'Hawaii', url: '/hawaii/' },
    { label: 'Oahu', url: '/hawaii/oahu/' },
    { label: 'Kuilima Cove' }
  ]} />

  <Hero
    title="Kuilima Cove Snorkeling"
    subtitle="The North Shore's best-kept secret, a protected cove with calm water, sea turtles, and zero crowds."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-ocean-900 mb-6">Water Activities at Kuilima Cove</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {activities.map(activity => (
        <ActivityCard activitySlug={activity.slug} regionSlug="oahu" />
      ))}
    </div>
  </section>

  <section class="bg-ocean-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ocean-900 mb-6">Why Kuilima Cove?</h2>
      <div class="prose-custom">
        <p>Kuilima Cove is the perfect alternative to crowded Hanauma Bay. Located at Turtle Bay Resort on the North Shore, this protected cove offers:</p>
        <ul>
          <li><strong>Calm, shallow water</strong>, 3–8 feet deep, protected from ocean swells</li>
          <li><strong>Free access</strong>, no entry fee, free parking at the resort</li>
          <li><strong>Sea turtles</strong>, frequent sightings in the cove</li>
          <li><strong>Beginner-friendly</strong>, sandy entry, no rocks to navigate</li>
          <li><strong>Year-round</strong>, protected from winter swells that make other North Shore spots dangerous</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <FAQSection items={faqs} />
  </section>
</Layout>