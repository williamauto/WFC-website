---
import Layout from '../../../../layouts/Layout.astro';
import Hero from '../../../../components/Hero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ActivityCard from '../../../../components/ActivityCard.astro';
import OperatorCard from '../../../../components/OperatorCard.astro';
import FAQSection from '../../../../components/FAQSection.astro';
import { getRegion, getActivitiesForRegion } from '../../../../data/site-data';
import { buildTouristDestinationSchema, buildBreadcrumbSchema, buildFAQSchema } from '../../../../data/schema';

const region = getRegion('oahu');
const activities = getActivitiesForRegion('oahu');

const faqs = [
  {
    question: 'What water activities can I do in Waikiki?',
    answer: 'Waikiki offers snorkeling right off the beach, beginner surfing lessons (the gentle waves are perfect for learning), paddle boarding, outrigger canoe rides, and sunset catamaran cruises. You can also book efoil lessons and electric boat rentals.'
  },
  {
    question: 'Is Waikiki good for beginner surfers?',
    answer: 'Yes, Waikiki is one of the best places in the world to learn surfing. The waves are small and gentle (1–3 feet most days), the water is warm year-round, and there are dozens of surf schools on the beach. Group lessons cost $60–$100 for 2 hours.'
  },
  {
    question: 'What is the best sunset cruise in Waikiki?',
    answer: 'The most popular sunset cruises are the catamaran sails (like the Holokai Catamaran) that depart from Waikiki Beach. They cost $50–$90 per person and include drinks. For a premium experience, the Star of Honolulu dinner cruise offers dinner, live music, and sunset views.'
  }
];

const schema = [
  buildTouristDestinationSchema({
    name: 'Waikiki',
    description: 'Waikiki, world-famous beach with snorkeling, surfing, and sunset cruises.',
    url: '/hawaii/oahu/waikiki/',
    activities
  }),
  buildBreadcrumbSchema([
    { label: 'Home', url: '/' },
    { label: 'Hawaii', url: '/hawaii/' },
    { label: 'Oahu', url: '/hawaii/oahu/' },
    { label: 'Waikiki', url: '/hawaii/oahu/waikiki/' }
  ]),
  buildFAQSchema(faqs)
];
---

<Layout title="Waikiki Water Activities, Surfing, Snorkeling & Cruises" description="Waikiki water activities: surfing lessons, snorkeling, sunset cruises, paddle boarding, and efoil. Complete guide." schema={schema}>
  <Breadcrumbs items={[
    { label: 'Home', url: '/' },
    { label: 'Hawaii', url: '/hawaii/' },
    { label: 'Oahu', url: '/hawaii/oahu/' },
    { label: 'Waikiki' }
  ]} />

  <Hero
    title="Waikiki Water Activities"
    subtitle="The world's most famous beach, gentle waves for learning to surf, calm waters for snorkeling, and legendary sunset cruises."
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold text-ocean-900 mb-6">Water Activities in Waikiki</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {activities.map(activity => (
        <ActivityCard activitySlug={activity.slug} regionSlug="oahu" />
      ))}
    </div>
  </section>

  <section class="bg-ocean-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-ocean-900 mb-6">Top Waikiki Experiences</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="rounded-xl border border-dashed border-ocean-200 bg-white p-6 text-center col-span-full">
            <p class="text-sm text-gray-600">Verified tours and operators for this spot are being added. Check back soon, or <a href="/list-your-business/" class="text-ocean-600 underline">list your business</a> if you run one here.</p>
          </div>
      </div>
      <p class="text-xs text-gray-500 mt-4">* Water Fun Club may earn a commission from bookings made through these links.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <FAQSection items={faqs} />
  </section>
</Layout>